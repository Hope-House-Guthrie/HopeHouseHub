{
    "folders": [
        {
            "path": "."
        }
    ],
    "settings": {
        "js/ts.preferences.quoteStyle": "double",
        "[typescript]": {
            "editor.defaultFormatter": "esbenp.prettier-vscode",
            "editor.formatOnSave": true,
            "editor.tabSize": 2
        },
        "[javascript]": {
            "editor.defaultFormatter": "esbenp.prettier-vscode",
            "editor.formatOnSave": true,
            "editor.tabSize": 2
        },
        "yaml.format.enable": true,
        "yaml.validate": true,
        "[yaml]": {
            "editor.defaultFormatter": "redhat.vscode-yaml",
            "editor.formatOnSave": true,
            "editor.tabSize": 2
        },
        "terminal.integrated.env.linux": {
            "DIRENV_LOG_FORMAT": "" // Silences direnv verbose output in new tabs
        }
    },
    "extensions": {
        "recommendations": [
            "jnoortheen.nix-ide",
            "Oven.bun-vscode",
            "esbenp.prettier-vscode",
            "redhat.vscode-yaml"
        ]
    }
}